# SPDX-License-Identifier: AGPL-3.0-only
#
# Copy to .env and set ADMIN_PASSWORD. That is the whole of the configuration that
# has to happen before the stack starts — the database, the blob store and the
# encryption key all bring themselves up:
#
#   cp .env.example .env
#   docker compose up -d
#
# Everything else — mailboxes and their credentials, the Microsoft application
# registration, lists, users, retrospective scans — is done by an administrator in
# the browser at http://127.0.0.1:8740 afterwards.

# The first administrator. Sign in with these, then change the password.
# The account is created only on a first run; afterwards this is ignored.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# The database password. Used by Postgres and by everything that talks to it.
# Defaults to "lazaret" if left empty, which is fine for an evaluation and not for
# anything else.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Everything below is optional and has a working default.
# ---------------------------------------------------------------------------

# The key that encrypts mailbox credentials at rest.
#
# Left empty, the engine generates one on first start into the `state` volume. Set it
# here — or inject it from a secret manager — to keep the key somewhere other than
# beside the data it protects.
#
# Changing it after mailboxes exist does not re-encrypt anything: the old credentials
# become unreadable and every mailbox has to be entered again.
#LAZARET_SECRET_KEY=

# Object storage credentials.
#
# Leave these alone. garage-init generates a key on first start, grants it the two
# buckets and writes it to a volume the engine reads — so nothing has to be created
# by hand, printed, or copied back into this file.
#
# Set both to use your own instead; garage-init imports them rather than generating.
# Setting only one is ignored.
#S3_ACCESS_KEY=
#S3_SECRET_KEY=

# Where this deployment is reachable from the internet, if it is.
#
# Set it and Microsoft 365 uses webhooks: the callback URL is built from this, and
# your reverse proxy should send that path to the ingest service on port 8731.
# Leave it empty and Microsoft is polled instead, which needs no inbound path and
# is the right answer for most deployments.
#
# An environment variable rather than a settings page because it is a fact about
# your network, settled when the proxy was configured, not a policy somebody
# revisits. Must be https — Microsoft refuses anything else.
#LAZARET_PUBLIC_URL=https://lazaret.example.com

# Microsoft 365 needs nothing else here: the application registration is set in the
# web interface under Settings → Microsoft 365, and the client secret is encrypted
# with the deployment key like any mailbox credential.

# Inline scanning with Rspamd. The shared secret its Lua plugin sends; see
# services/ingest/lua/. Leave empty if Rspamd is not in front of this deployment.
#RSPAMD_SECRET=

# An existing Strelka, if you are not using the bundled one.
#STRELKA_ADDR=strelka:57314

# Inference on an AMD GPU. Requires the ROCm overlay:
#   docker compose -f docker-compose.yml -f docker-compose.rocm.yml up -d
# RENDER_GID must be the group owning /dev/kfd — find it with: stat -c %g /dev/kfd
#RENDER_GID=
#VIDEO_GID=44


# What a link visit presents itself as.
#
# Phishing kits cloak: they serve a benign page to anything that looks like a scanner
# and the credential form to everyone else. So these are not cosmetic — they decide
# whether the page analysed is the page the recipient saw.
#
# The languages to ask for, as a bare comma-separated list. Quality values are added
# automatically. A deployment protecting Spanish speakers should ask for Spanish.
#LAZARET_ACCEPT_LANGUAGE=es-ES,es,en

# The platform to present as: linux, windows or macos. Consider windows if the
# recipients are a typical corporate population — the aim is to look like them.
#LAZARET_BROWSER_PLATFORM=windows
